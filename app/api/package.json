{
  "name": "@dashboard-hackatown/api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "API do painel Saúde das rotas: serve o contrato de docs/DADOS.md, guarda as ações e roda a IA do recorte.",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "etl": "tsx src/etl/run.ts",
    "etl:check": "tsx src/etl/check.ts",
    "eval": "tsx scripts/eval.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.14.0",
    "@fastify/cors": "^11.1.0",
    "exceljs": "^4.4.0",
    "fastify": "^5.6.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "tsx": "^4.20.6",
    "typescript": "^5.6.3"
  }
}
