# Rodando a API fora do Docker (npm run dev). No Docker, quem define é o docker-compose.yml.

# Porta da API (o front aponta VITE_API_URL para cá).
PORT=7333

# Postgres. `docker compose up -d db` sobe um em localhost:7432 com estes dados.
DATABASE_URL=postgres://saude:saude@localhost:7432/saude_rotas

# Fonte de dados: vazio = gold (se o ETL já rodou) ou json (dados fictícios do front).
# Valores: gold | json
DATA_SOURCE=

# Claude API. A ação sugerida SEMPRE usa IA: sem chave a tela mostra erro com "Tentar de novo".
# A extração de ocorrências cai no modo simulado sem chave.
ANTHROPIC_API_KEY=
# AI_PROVIDER=fake   # só para testes/desenvolvimento: usa o modo simulado (regras) também na ação sugerida

# Servidor MCP (app/mcp) e segredos de uso interno. Troque os valores em produção.
MCP_URL=http://localhost:7335/mcp
MCP_ESCOPO_SECRET=checkroute-escopo-dev
INTERNAL_TOKEN=checkroute-interno-dev
LEITURA_PASSWORD=leitura
# Contatos de teste do WhatsApp (seu número): telefone:nome:papel:T02,T05;outro...
# WA_CONTATOS_DEMO=

# Opcional: caminho da planilha bronze (padrão: docs/bronze_planilha.xlsx).
# BRONZE_PATH=
