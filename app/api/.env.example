# Porta da API (o front aponta VITE_API_URL para cá).
PORT=3333

# Fonte de dados: vazio = gold (se o `npm run etl` já rodou) ou json (dados fictícios do front).
# Valores: gold | json
DATA_SOURCE=

# Claude API. Sem chave, a IA roda em modo simulado (regras simples) e a demo não trava.
ANTHROPIC_API_KEY=
# AI_PROVIDER=fake   # força o modo simulado mesmo com chave

# Opcional: outro caminho para o SQLite.
# DB_PATH=./data/app.db
