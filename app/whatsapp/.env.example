# Rodando fora do Docker (npm run dev -w app/whatsapp). No Docker, quem define é o docker-compose.yml.
PORT=7334

# ---- Meta / WhatsApp Cloud API (developers.facebook.com → seu app → WhatsApp → API Setup) ----
# Token de acesso (use um token de System User permanente; o temporário vence em 24 h).
META_ACCESS_TOKEN=
# "Phone number ID" do número que envia (não é o número de telefone).
META_PHONE_NUMBER_ID=
# App secret (App settings → Basic). Usado para conferir a assinatura X-Hub-Signature-256 do webhook.
META_APP_SECRET=
# Texto livre que você inventa e repete na tela de configuração do webhook da Meta.
META_VERIFY_TOKEN=troque-este-token
# Versão da Graph API (use a mesma da sua collection do Postman).
META_GRAPH_VERSION=v23.0
# 1 = não chama a Meta: só registra no log o que seria enviado (para testar com scripts/simular.ts).
META_DRY_RUN=

# ---- API do painel (app/api) ----
API_URL=http://localhost:7333

# ---- Estado das conversas (mesmo Postgres da API, tabelas wa_*) ----
DATABASE_URL=postgres://saude:saude@localhost:7432/saude_rotas

# ---- Claude ----
# Sem chave, o agente roda em modo simulado (regras fixas) e a demo não trava.
ANTHROPIC_API_KEY=
WA_MODELO=claude-opus-5-5
# AI_PROVIDER=fake   # força o modo simulado

# ---- Painel de atendimentos (aba Atendimentos do app/web) ----
# Token que o painel manda em Authorization: Bearer. Gere um longo (ex.: openssl rand -hex 24). Vazio = desligado.
WA_ADMIN_TOKEN=
# Origens do painel (ex.: https://checkroute.wfelipe.com.br,http://localhost:5173). Vazio = qualquer uma.
WA_CORS_ORIGENS=

# ---- Segurança ----
# Números autorizados a registrar ocorrências (DDI+DDD+número, separados por vírgula). Vazio = qualquer número.
WA_NUMEROS_PERMITIDOS=
